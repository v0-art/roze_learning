# Copy to .env.vps. Point the domain's DNS A/AAAA records to your VPS first.
SITE_ADDRESS=learning.example.com
# Generate three different random base64url values of at least 32 characters.
POSTGRES_PASSWORD=replace_with_random_database_password
APP_DB_PASSWORD=replace_with_random_application_password
INITIAL_ADMIN_PASSWORD=replace_with_random_administrator_password
COOKIE_SECURE=true
