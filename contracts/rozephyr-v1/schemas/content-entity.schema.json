{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rozephyr.learning/contracts/1.0/content-entity.schema.json",
  "title": "Rozephyr Content Entity 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "title",
    "version",
    "status",
    "content"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
    },
    "kind": {
      "enum": [
        "course",
        "module",
        "topic",
        "lesson",
        "remedial",
        "control_work",
        "exam",
        "assessment_bank",
        "skill",
        "relation",
        "regulation"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "published",
        "archived"
      ]
    },
    "moduleId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
    },
    "topicIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
      },
      "uniqueItems": true
    },
    "content": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "lesson",
              "remedial"
            ]
          }
        }
      },
      "then": {
        "required": [
          "moduleId",
          "topicIds"
        ],
        "properties": {
          "content": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "durationMinutes",
              "blocks",
              "skillIds"
            ],
            "properties": {
              "durationMinutes": {
                "type": "integer",
                "minimum": 1
              },
              "blocks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "blockId",
                    "role",
                    "order",
                    "textPath"
                  ],
                  "properties": {
                    "blockId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
                    },
                    "role": {
                      "enum": [
                        "opening",
                        "theory",
                        "example",
                        "practice",
                        "assessment",
                        "homework",
                        "conclusion",
                        "instruction"
                      ]
                    },
                    "order": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "textPath": {
                      "type": "string",
                      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
                    }
                  }
                }
              },
              "skillIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "control_work",
              "exam"
            ]
          }
        }
      },
      "then": {
        "required": [
          "moduleId",
          "topicIds"
        ],
        "properties": {
          "content": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "assessmentBankId",
              "rubric",
              "blocksNext"
            ],
            "properties": {
              "assessmentBankId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
              },
              "rubric": {
                "type": "object",
                "required": [
                  "maxScore"
                ],
                "properties": {
                  "maxScore": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "additionalProperties": true
              },
              "blocksNext": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "module"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "required": [
              "description"
            ],
            "properties": {
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "topic"
          }
        }
      },
      "then": {
        "required": [
          "moduleId"
        ],
        "properties": {
          "content": {
            "type": "object",
            "required": [
              "description"
            ],
            "properties": {
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "assessment_bank"
          }
        }
      },
      "then": {
        "required": [
          "moduleId"
        ],
        "properties": {
          "content": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tickets"
            ],
            "properties": {
              "tickets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ticketId",
                    "theory1",
                    "theory2",
                    "practical"
                  ],
                  "properties": {
                    "ticketId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
                    },
                    "topicId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
                    },
                    "theory1": {
                      "type": "string",
                      "minLength": 1
                    },
                    "theory2": {
                      "type": "string",
                      "minLength": 1
                    },
                    "practical": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
