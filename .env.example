# Use two distinct, strong passwords of at least 16 characters.
# Login names: mentor and student. Do not commit actual secrets.
NEXUS_MENTOR_PASSWORD=
NEXUS_STUDENT_PASSWORD=
PORT=3000

# Set true when serving over HTTPS (Secure session cookie).
NEXUS_COOKIE_SECURE=false

# The local relational server reads its database URL from .env.relational.
# Keep credentials out of Git. For VPS deployment see .env.vps.example and docs/VPS_DOCKER.md.
# npm run dev:json is available only for the old, separate JSON backend.
NEXUS_RELATIONAL_DATABASE_URL=
