{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/relational-server.mjs",
    "dev:json": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "start": "node scripts/relational-server.mjs",
    "test:acceptance": "node --import tsx --test src/core/acceptance.test.ts",
    "test": "node --import tsx --test src/core/*.test.ts",
    "test:integration": "node --import tsx --test src/core/server.integration.test.ts",
    "test:e2e": "node --test tests/browser.e2e.mjs",
    "test:e2e:relational": "node --import tsx --test tests/relational-browser.e2e.ts",
    "test:v3": "node --import tsx --test tests/v3-contracts.test.ts tests/v3-sequence.test.ts tests/relational-v3-content.integration.ts tests/relational-v3-m01-import.integration.ts tests/relational-v3-m01-full.integration.ts tests/relational-v3-cross-topic.integration.ts tests/relational-v3-ticket-topic.integration.ts tests/relational-v3-session.integration.ts tests/relational-v3-assessments.integration.ts",
    "test:v3:external": "node --import tsx scripts/validate-external-v3.ts",
    "test:proxy": "node --import tsx --test tests/proxy-rate-limit.integration.ts",
    "test:v3:e2e": "node --import tsx --test tests/relational-v3-browser.e2e.ts tests/relational-v3-cross-topic-browser.e2e.ts tests/relational-v3-two-modules-browser.e2e.ts tests/relational-v3-m01-browser.e2e.ts tests/relational-v3-m01-full-browser.e2e.ts",
    "backup": "tsx scripts/backup.ts",
    "demo:visible": "node scripts/visible-demo.mjs start",
    "data:init": "node scripts/init-data.mjs",
    "db:setup": "node scripts/postgres.mjs setup",
    "db:validate": "node scripts/postgres.mjs validate",
    "db:migrate": "node scripts/postgres.mjs migrate",
    "db:verify": "node scripts/postgres.mjs verify",
    "db:relational:preflight": "node scripts/relational-preflight.mjs",
    "db:relational:import": "tsx scripts/relational-import.ts",
    "db:relational:permissions": "tsx scripts/relational-permissions.ts",
    "db:permissions": "node scripts/postgres.mjs permissions",
    "db:backup": "node scripts/relational-backup.mjs",
    "db:legacy:backup": "node scripts/postgres.mjs backup",
    "db:legacy:restore": "node scripts/postgres.mjs restore",
    "test:postgres": "node --import tsx --test tests/postgres.integration.ts tests/postgres-server.integration.ts tests/postgres-backup.integration.ts tests/postgres-import.integration.ts tests/relational-schema.integration.ts tests/course-repository.integration.ts tests/course-routes.integration.ts tests/relational-api.integration.ts tests/relational-server.integration.ts tests/relational-permissions.integration.ts tests/account-repository.integration.ts tests/legacy-accounts.integration.ts tests/relational-migrations.integration.ts tests/legacy-curriculum.integration.ts tests/legacy-activities.integration.ts tests/relational-staging.integration.ts tests/relational-import.integration.ts tests/relational-learning.integration.ts tests/relational-preflight.test.ts",
    "dev:postgres": "node scripts/postgres.mjs serve",
    "dev:relational": "node scripts/relational-server.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/svg-captcha": "^1.4.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "svg-captcha": "^1.4.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
